--- a/environments/kernel_arena/module/ka_vuln.c
+++ b/environments/kernel_arena/module/ka_vuln.c
@@ -78,10 +78,13 @@ static long ka_handle_write(struct file *f, unsigned long arg)
 {
     struct ka_request req;
 
     if (copy_from_user(&req, (void __user *)arg, sizeof(req)))
         return -EFAULT;
 
-    /* BUG: no bounds enforcement on req.len */
+    /* Fix: clamp length to buffer size */
+    size_t safe_len = min(req.len, (size_t)KA_BUF_SIZE);
+
     mutex_lock(&ka_lock);
-    if (copy_from_user(ka_buffer, req.data, req.len)) {
